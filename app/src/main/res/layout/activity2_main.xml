<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="wrap_content"
    android:layout_height="match_parent"
    android:background="#FFF2A5"
    tools:context=".MainActivity">

    <androidx.cardview.widget.CardView
        android:layout_width="426dp"
        android:layout_height="680dp"
        android:layout_marginTop="100dp"
        android:layout_marginBottom="-30dp"
        app:cardCornerRadius="60dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0.533"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintVertical_bias="0.0">

        <TextView
            android:id="@+id/textView"
            android:layout_width="311dp"
            android:layout_height="31dp"
            android:layout_marginHorizontal="25pt"
            android:layout_marginTop="30dp"
            android:fontFamily="sans-serif-medium"
            android:letterSpacing="0.10"
            android:text="Create Your Account"
            android:textAlignment="center"
            android:textSize="25sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/textView2"
            android:layout_width="223dp"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="45pt"
            android:layout_marginTop="70dp"
            android:text="We're to help you reach the peaks of learning. Are you Ready?"
            android:textAlignment="center" />

        <TextView
            android:id="@+id/textView5"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="22pt"
            android:layout_marginTop="60pt"
            android:text="Student's Full Name"
            android:textSize="16sp"
            android:textStyle="bold" />

        <com.google.android.material.textfield.TextInputLayout
            android:layout_width="332dp"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="20pt"
            android:layout_marginTop="70pt"
            android:paddingBottom="2sp"
            app:boxCornerRadiusBottomEnd="15dp"
            app:boxCornerRadiusBottomStart="15dp"
            app:boxCornerRadiusTopEnd="15dp"
            app:boxCornerRadiusTopStart="15dp"
            app:boxStrokeColor="#5B91A3"
            app:hintTextColor="#5B91A3">

            <com.google.android.material.textfield.TextInputEditText
                android:layout_width="match_parent"
                android:layout_height="45dp"
                android:hint="Last Name" />
        </com.google.android.material.textfield.TextInputLayout>

        <com.google.android.material.textfield.TextInputLayout
            android:layout_width="331dp"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="20pt"
            android:layout_marginTop="95pt"
            app:boxCornerRadiusBottomEnd="15dp"
            app:boxCornerRadiusBottomStart="15dp"
            app:boxCornerRadiusTopEnd="15dp"
            app:boxCornerRadiusTopStart="15dp"
            app:boxStrokeColor="#5B91A3"
            app:hintTextColor="#5B91A3">>

            <com.google.android.material.textfield.TextInputEditText
                android:layout_width="match_parent"
                android:layout_height="44dp"
                android:hint="First Name" />

        </com.google.android.material.textfield.TextInputLayout>

        <com.google.android.material.textfield.TextInputLayout
            android:layout_width="331dp"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="20pt"
            android:layout_marginTop="120pt"
            app:boxCornerRadiusBottomEnd="15dp"
            app:boxCornerRadiusBottomStart="15dp"
            app:boxCornerRadiusTopEnd="15dp"
            app:boxCornerRadiusTopStart="15dp"
            app:boxStrokeColor="#5B91A3"
            app:hintTextColor="#5B91A3">>

            <com.google.android.material.textfield.TextInputEditText
                android:layout_width="match_parent"
                android:layout_height="44dp"
                android:hint="Middle Name" />

        </com.google.android.material.textfield.TextInputLayout>

        <TextView
            android:id="@+id/textView6"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="22pt"
            android:layout_marginTop="155pt"
            android:layout_marginBottom="5pt"
            android:text="Student's Academic Information"
            android:textSize="16sp"
            android:textStyle="bold" />

        <com.google.android.material.textfield.TextInputLayout
            android:layout_width="214dp"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="20pt"
            android:layout_marginTop="165pt"
            app:boxCornerRadiusBottomEnd="15dp"
            app:boxCornerRadiusBottomStart="15dp"
            app:boxCornerRadiusTopEnd="15dp"
            app:boxCornerRadiusTopStart="15dp"
            app:boxStrokeColor="#5B91A3"
            app:hintTextColor="#5B91A3">>

            <com.google.android.material.textfield.TextInputEditText
                android:layout_width="match_parent"
                android:layout_height="44dp"
                android:hint="Program" />

        </com.google.android.material.textfield.TextInputLayout>

        <com.google.android.material.textfield.TextInputLayout
            android:layout_width="111dp"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="120pt"
            android:layout_marginTop="165pt"
            app:boxCornerRadiusBottomEnd="15dp"
            app:boxCornerRadiusBottomStart="15dp"
            app:boxCornerRadiusTopEnd="15dp"
            app:boxCornerRadiusTopStart="15dp"
            app:boxStrokeColor="#5B91A3"
            app:hintTextColor="#5B91A3">>

            <com.google.android.material.textfield.TextInputEditText
                android:layout_width="match_parent"
                android:layout_height="44dp"
                android:hint="Year Level" />

        </com.google.android.material.textfield.TextInputLayout>

        <com.google.android.material.textfield.TextInputLayout
            android:layout_width="334dp"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="20pt"
            android:layout_marginTop="190pt"
            app:boxCornerRadiusBottomEnd="15dp"
            app:boxCornerRadiusBottomStart="15dp"
            app:boxCornerRadiusTopEnd="15dp"
            app:boxCornerRadiusTopStart="15dp"
            app:boxStrokeColor="#5B91A3"
            app:hintTextColor="#5B91A3">>

            <com.google.android.material.textfield.TextInputEditText
                android:layout_width="match_parent"
                android:layout_height="44dp"
                android:hint="Specialization" />

        </com.google.android.material.textfield.TextInputLayout>


        <Button
            android:id="@+id/button"
            android:layout_width="293dp"
            android:layout_height="57dp"
            android:layout_marginHorizontal="30pt"
            android:layout_marginTop="230pt"
            android:backgroundTint="#1B365D"
            android:text="Create Account"
            android:textSize="18sp"/>



    </androidx.cardview.widget.CardView>

</androidx.constraintlayout.widget.ConstraintLayout>